# Manage default profile(s)

.zem_default() {
    emulate -L zsh
    setopt extended_glob warn_create_global typeset_silent

    local MATCH REPLY
    integer MBEGIN MEND
    local -a match mbegin mend reply

    local profile_dir="${XDG_CONFIG_HOME:-$HOME/.config}/zem/profiles"
    local -a profiles

    [[ $1 == (-h|--help|help) ]] && { .zem_help default; return $? }

    # Handle --unset flag
    if [[ $1 == "--unset" ]]; then
        .zem_config_set default_profile "" || {
            echo "${ZEM_MSGS[default_unset_failed]}"
            return 1
        }
        echo "${ZEM_MSGS[default_unset_success]}"
        echo "${ZEM_MSGS[default_unset_hint]}"
        return 0
    fi

    # Handle --remove flag
    if [[ $1 == "--remove" ]]; then
        shift
        if (( $# == 0 )); then
            echo "${ZEM_MSGS[common_missing_profile]}"
            return 1
        fi

        local current=$(.zem_config_get default_profile)
        local -a current_list=(${(s: :)current})
        local -a removed_list
        local profile

        for profile in "$@"; do
            local idx=${current_list[(Ie)$profile]}
            if (( idx > 0 )); then
                current_list[idx]=()
                removed_list+=("$profile")
            else
                printf "${ZEM_MSGS[default_remove_not_found]}\n" "$profile"
            fi
        done

        if (( ${#removed_list} > 0 )); then
            .zem_config_set default_profile "${current_list[*]}" || {
                echo "${ZEM_MSGS[default_set_failed]}"
                return 1
            }
            printf "${ZEM_MSGS[default_remove_success]}\n" "${removed_list[*]}"
        fi
        return 0
    fi

    # If no argument, show current default(s)
    if (( $# == 0 )); then
        local current=$(.zem_config_get default_profile)
        if [[ -z $current ]]; then
            echo "${ZEM_MSGS[default_none]}"
            echo "${ZEM_MSGS[default_usage]}"
        else
            printf "${ZEM_MSGS[default_current]}\n" "$current"
            local p
            for p in ${(s: :)current}; do
                if [[ ! -f $profile_dir/$p ]]; then
                    printf "${ZEM_MSGS[default_warn_missing]}\n" "$p"
                fi
            done
        fi
        return 0
    fi

    profiles=("$@")

    # Validate each profile exists
    local profile
    for profile in "${profiles[@]}"; do
        .zem_validate_profile_name "$profile" || return 1
        if [[ ! -f $profile_dir/$profile ]]; then
            printf "${ZEM_MSGS[common_not_exist]}\n" "$profile"
            echo "${ZEM_MSGS[common_list_hint]}"
            return 1
        fi
    done

    # Append to existing defaults (deduplicate)
    local current=$(.zem_config_get default_profile)
    local -a current_list=(${(s: :)current})
    local -a appended_list

    for profile in "${profiles[@]}"; do
        if (( current_list[(Ie)$profile] == 0 )); then
            current_list+=("$profile")
            appended_list+=("$profile")
        fi
    done

    if (( ${#appended_list} == 0 )); then
        echo "${ZEM_MSGS[default_already_set]}"
        return 0
    fi

    .zem_config_set default_profile "${current_list[*]}" || {
        echo "${ZEM_MSGS[default_set_failed]}"
        return 1
    }

    if (( ${#appended_list} == 1 )); then
        printf "${ZEM_MSGS[default_append_single]}\n" "${appended_list[1]}"
        echo "${ZEM_MSGS[default_set_hint_single]}"
    else
        printf "${ZEM_MSGS[default_append_multi]}\n" "${appended_list[*]}"
        echo "${ZEM_MSGS[default_set_hint_multi]}"
    fi
    return 0
}
